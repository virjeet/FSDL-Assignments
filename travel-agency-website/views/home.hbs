<!-- HERO -->
<section class="hero">
  <div class="hero-bg">
    <img src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1600&q=85" alt="World travel" class="hero-img" />
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-content">
    <p class="hero-eyebrow">Curated Luxury Travel</p>
    <h1 class="hero-title">The World<br /><em>Awaits You</em></h1>
    <p class="hero-subtitle">Handcrafted itineraries. Private guides. Unforgettable moments.</p>
    <a href="/destinations" class="btn btn-primary">Explore Destinations</a>
  </div>
  <div class="hero-stats">
    <div class="stat"><span class="stat-num">150+</span><span class="stat-label">Destinations</span></div>
    <div class="stat"><span class="stat-num">14K+</span><span class="stat-label">Happy Travellers</span></div>
    <div class="stat"><span class="stat-num">16</span><span class="stat-label">Years of Excellence</span></div>
  </div>
</section>

<!-- FEATURED DESTINATIONS -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Handpicked for You</p>
      <h2 class="section-title">Featured Destinations</h2>
    </div>
    <div class="card-grid">
      {{#each featured}}
      <article class="dest-card">
        <a href="/destinations/{{_id}}" class="dest-card-link">
          <div class="dest-card-img-wrap">
            <img src="{{image}}" alt="{{name}}" class="dest-card-img" loading="lazy" />
            <span class="dest-card-category">{{category}}</span>
          </div>
          <div class="dest-card-body">
            <h3 class="dest-card-name">{{name}}</h3>
            <p class="dest-card-tagline">{{tagline}}</p>
            <div class="dest-card-footer">
              <div class="dest-rating">
                <span class="stars-gold">★</span> {{rating}}
                <span class="reviews">({{reviews}})</span>
              </div>
              <div class="dest-price">
                From <strong>{{formatPrice price}}</strong>
              </div>
            </div>
          </div>
        </a>
      </article>
      {{/each}}
    </div>
    <div class="section-cta">
      <a href="/destinations" class="btn btn-outline">View All Destinations</a>
    </div>
  </div>
</section>

<!-- WHY US -->
<section class="why-us">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">The WanderLux Difference</p>
      <h2 class="section-title">Travel Elevated</h2>
    </div>
    <div class="features-grid">
      <div class="feature">
        <div class="feature-icon">✦</div>
        <h3>Expert Curation</h3>
        <p>Every itinerary is designed by specialists who have lived in the destination.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">◈</div>
        <h3>Private Experiences</h3>
        <p>Skip the crowds. Access temples at dawn, private vineyard dinners, hidden beaches.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">◉</div>
        <h3>24/7 Concierge</h3>
        <p>A dedicated travel manager is reachable any hour, from any time zone.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">❋</div>
        <h3>Sustainable Travel</h3>
        <p>Carbon-offset itineraries and partnerships with responsible local operators.</p>
      </div>
    </div>
  </div>
</section>

<!-- PACKAGES -->
<section class="section section-dark">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Complete Holiday Solutions</p>
      <h2 class="section-title">Popular Packages</h2>
    </div>
    <div class="pkg-grid">
      {{#each topPackages}}
      <article class="pkg-card">
        <div class="pkg-card-img-wrap">
          <img src="{{image}}" alt="{{name}}" class="pkg-card-img" loading="lazy" />
          {{#if badge}}<span class="badge {{badgeClass badge}}">{{badge}}</span>{{/if}}
        </div>
        <div class="pkg-card-body">
          <h3>{{name}}</h3>
          <p class="pkg-destinations">{{join destinations " · "}}</p>
          <ul class="pkg-inclusions">
            {{#each inclusions}}
            <li>✓ {{this}}</li>
            {{/each}}
          </ul>
          <div class="pkg-footer">
            <div class="pkg-meta">
              <span>{{duration}}</span>
              <span class="pkg-price">From <strong>{{formatPrice price}}</strong></span>
            </div>
            <a href="/book/package/{{_id}}" class="btn btn-sm">Book Now</a>
          </div>
        </div>
      </article>
      {{/each}}
    </div>
    <div class="section-cta">
      <a href="/packages" class="btn btn-outline-light">View All Packages</a>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Traveller Stories</p>
      <h2 class="section-title">What They're Saying</h2>
    </div>
    <div class="testi-grid">
      {{#each testimonials}}
      <blockquote class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <p class="testi-text">"{{text}}"</p>
        <footer class="testi-author">
          <span class="testi-avatar">{{avatar}}</span>
          <div>
            <strong>{{name}}</strong>
            <span>{{location}} · {{trip}}</span>
          </div>
        </footer>
      </blockquote>
      {{/each}}
    </div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="cta-banner">
  <div class="cta-banner-bg">
    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80" alt="" />
    <div class="hero-overlay"></div>
  </div>
  <div class="cta-banner-content">
    <h2>Ready to Begin Your Journey?</h2>
    <p>Speak with a travel specialist today — no obligation, just inspiration.</p>
    <div class="cta-actions">
      <a href="/destinations" class="btn btn-primary">Browse Destinations</a>
      <a href="/contact" class="btn btn-ghost">Talk to an Expert</a>
    </div>
  </div>
</section>
